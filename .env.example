# Copia este archivo a .env. Nunca pongas claves en static/ ni en los prompts.
AGENT_API_KEY=
OLLAMA_API_KEY=
# Opcional: instancia de SearXNG con formato JSON habilitado.
SEARXNG_URL=
# Activa solo cuando sirvas la aplicación mediante HTTPS.
COOKIE_SECURE=false
APP_HOST=127.0.0.1
APP_PORT=8000
# Recuperación de cuentas con Gmail (activar verificación en dos pasos y crear una contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Opcional: usa SMTP_USERNAME cuando esté vacío.
SMTP_FROM=
# Debe ser la dirección real desde la que los usuarios abren la aplicación.
# En Internet usa HTTPS; 127.0.0.1 solo sirve para abrir los enlaces en este equipo.
APP_PUBLIC_URL=http://127.0.0.1:8000
